# ==============================================================================
# Ruiru Titans Football Platform - Production Environment Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Core Settings
# In production, set DEBUG=False
DEBUG=False

# Generate a cryptographically strong secret key using:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace_with_your_own_generated_production_secret_key

# Hostnames allowed to serve the application (comma-separated)
# Restrict to your domain and wildcard subdomains
ALLOWED_HOSTS=ruirutitans.com,.ruirutitans.com

# Server Port
PORT=8000

# ==============================================================================
# Database Configuration
# ==============================================================================
# Supported DB_ENGINE options: 'sqlite' | 'mysql' | 'postgresql'
DB_ENGINE=sqlite

# If DB_ENGINE=sqlite:
SQLITE_PATH=db.sqlite3

# If DB_ENGINE=mysql:
# MYSQL_DATABASE=ruirutitans
# MYSQL_USER=titans_user
# MYSQL_PASSWORD=your_secure_db_password
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# If DB_ENGINE=postgresql:
# POSTGRES_DB=ruirutitans
# POSTGRES_USER=titans_user
# POSTGRES_PASSWORD=your_secure_db_password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Or unified 12-factor connection string:
# DATABASE_URL=mysql://titans_user:your_secure_db_password@127.0.0.1:3306/ruirutitans

# Connection pooling max age (seconds)
DB_CONN_MAX_AGE=300

# ==============================================================================
# CORS & CSRF Configuration
# ==============================================================================
# Comma-separated list of allowed origins (credentials are enabled)
CORS_ALLOWED_ORIGINS=https://ruirutitans.com,https://www.ruirutitans.com

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://ruirutitans.com,https://*.ruirutitans.com

# ==============================================================================
# SSL & Security Headers (Active when DEBUG=False)
# ==============================================================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
